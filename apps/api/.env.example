# ============================================================
# openlms API — contoh environment (TANPA nilai secret)
# Salin menjadi `.env` (di apps/api atau root repo) lalu isi nilai.
# Jangan pernah commit file `.env` (lihat .gitignore + gitleaks).
# ============================================================

# --- Aplikasi ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Nama aplikasi tampilan (dipakai web; NEXT_PUBLIC_* dibaca di client)
NEXT_PUBLIC_APP_NAME=openlms

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openlms?schema=public"

# --- Auth (WAJIB secret kuat 32+ byte acak di production) ---
JWT_ACCESS_SECRET=change-me-32-bytes-random
JWT_REFRESH_SECRET=change-me-32-bytes-random
JWT_INVITATION_SECRET=change-me-32-bytes-random
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
JWT_INVITATION_TTL_DAYS=60
# Cookie httpOnly+Secure+SameSite. Secure=true wajib saat HTTPS (production).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- CORS: asal yang diizinkan (koma-pisah); dipakai REST + Socket.IO (/ws) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Trust proxy: true bila API di belakang reverse proxy (Nginx) ---
# Wajib agar req.ip (rate limit) membaca X-Forwarded-For dengan benar.
TRUST_PROXY=false

# --- Rate limit per-IP (in-memory, common/middleware/rate-limit.middleware.ts) ---
# Jendela waktu (ms), kuota umum per IP, kuota per-IDENTITAS USER (route
# terautentikasi), kuota ketat login (brute-force) & refresh.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
USER_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=30

# --- Storage lokal (unggah file) ---
STORAGE_LOCAL_DIR=./storage

# --- Redis (opsional; BullMQ/queue + Socket.IO adapter multi-instance) ---
REDIS_URL=redis://localhost:6379

# --- Web (konsumen API; dipakai apps/web) ---
# Base URL API (REST /api/v1). Konsisten dengan apps/web/src/lib/constants.ts.
NEXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
# URL Socket.IO namespace /ws (opsional; default diturunkan dari NEXT_PUBLIC_API_BASE).
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001/ws
