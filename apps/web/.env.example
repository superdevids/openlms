# ============================================================
# opensis Web — contoh environment (TANPA nilai secret)
# Salin menjadi `.env` (di apps/web atau root repo) lalu isi nilai.
# Hanya variabel NEXT_PUBLIC_* yang terbaca di client components.
# Jangan pernah commit file `.env` (lihat .gitignore + gitleaks).
# ============================================================

# --- Aplikasi ---
# Nama aplikasi (client-safe). Default "opensis"
# (src/lib/constants.ts → APP_NAME).
NEXT_PUBLIC_APP_NAME=opensis

# --- API backend ---
# Base URL API (prefix /api/v1). Default "/api/v1" (same-origin,
# src/lib/api-client.ts → API_BASE). Bila web dan API terpisah host,
# isi URL absolut, mis. http://localhost:3001/api/v1.
# Konsisten dengan API_BASE_FALLBACK (src/lib/constants.ts) = 3001.
NEXT_PUBLIC_API_BASE=http://localhost:3001/api/v1

# --- Demo mode (opsional) ---
# 1 = preview tanpa backend: login demo + data contoh, semua route bebas
# (src/lib/api-client.ts → DEMO_MODE, src/proxy.ts). Kosongkan/0 = normal.
NEXT_PUBLIC_DEMO=0

# --- Realtime (opsional) ---
# Base URL Socket.IO. Default "/ws" (same-origin,
# src/components/branding/branding-provider.tsx).
NEXT_PUBLIC_SOCKET_URL=/ws
