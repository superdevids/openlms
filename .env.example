# ============================================================
# opensis — contoh environment (TANPA nilai secret)
# Salin menjadi `.env` lalu isi nilai sesuai environment Anda.
# Jangan pernah commit file `.env` (lihat .gitignore + gitleaks).
#
# MODE DEV (default, ringan):
#   Infra (postgres, redis, nginx) di Docker; aplikasi di HOST via `npm run dev`.
#     cp .env.example .env        # isi secret (JWT, POSTGRES_PASSWORD, dll)
#     docker compose up -d        # hanya infra (3 service)
#     npm run dev                 # api :3001 + web :3000 di host
#     npm run db:migrate:deploy   # + npm run db:seed (postgres di localhost:5432)
#   Akses: http://localhost (Nginx :80 -> host.docker.internal)
#
# MODE PROD (full-stack, 5 service di container):
#   Ganti nilai untuk production (secret acak, CORS_ORIGINS asli, HTTPS),
#   lalu jalankan overlay:
#     docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#   Host postgres/redis = nama service (postgres/redis), bukan localhost.
#
# Perbedaan kunci DEV vs PROD dirangkum di bawah tiap variabel.
# ============================================================

# --- Aplikasi ---
NODE_ENV=development
# Port web. DEV: dipakai `npm run dev` di host (apps/web). PROD: dipakai web di container.
PORT=3000
# Nama aplikasi tampilan (dipakai web; NEXT_PUBLIC_* dibaca di client)
NEXT_PUBLIC_APP_NAME=opensis
# URL absolut situs untuk SEO (metadataBase/OG/JSON-LD). Wajib diisi URL publik
# produksi agar Open Graph & schema.org menghasilkan URL absolut yang benar.
# Default "http://localhost:3000" (apps/web/src/lib/constants.ts → APP_URL).
# NEXT_PUBLIC_APP_URL=https://sekolah.example.com

# --- Database (PostgreSQL) ---
# Prisma (packages/database). Ganti kredensial sesuai environment Anda.
# DEV: postgres di container, port terekspos ke localhost:5432.
# PROD: postgres di container, host = nama service `postgres` (bukan localhost),
#       dan URL dipakai oleh service api DI CONTAINER (overlay mengganti host
#       ke postgres; nilai ini untuk migrasi/seed dari HOST).
# >>> PENTING — DATABASE_URL vs docker compose <<<
# Saat postgres dijalankan via docker compose, kredensial DATABASE_URL harus SAMA
# dengan POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB di blok berikut, mis.:
#   DATABASE_URL="postgresql://opensis:change-me-32-bytes-random@localhost:5432/opensis?schema=public"
# Nilai POSTGRES_* di bawah dipakai docker-compose untuk container; jadi
# DATABASE_URL (host) harus memakai user/password/db yang SAMA saat migrasi/seed
# dari HOST agar `cp .env.example .env` langsung jalan (tanpa edit tambahan).
DATABASE_URL="postgresql://opensis:change-me-32-bytes-random@localhost:5432/opensis?schema=public"

# --- Kredensial container PostgreSQL (docker-compose.yml) ---
# Nilai POSTGRES_* dipakai docker-compose untuk container postgres
# (docker-compose.yml: POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB).
# TANPA variabel ini, docker-compose memakai default `postgres/postgres` —
# risiko production memakai password default. WAJIB konsisten dengan
# DATABASE_URL di atas (user:password@host:port/db) setelah diubah.
POSTGRES_USER=opensis
# WAJIB diganti: 32+ byte acak di production (mis. `openssl rand -base64 32`).
POSTGRES_PASSWORD=change-me-32-bytes-random
POSTGRES_DB=opensis

# --- Auth (Fase 1, skeleton siap) ---
# Wajib diganti dengan nilai acak kuat di production (32+ byte).
JWT_ACCESS_SECRET=change-me-32-bytes-random
JWT_REFRESH_SECRET=change-me-32-bytes-random
JWT_INVITATION_SECRET=change-me-32-bytes-random
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
JWT_INVITATION_TTL_DAYS=60
# Cookie httpOnly+Secure+SameSite. Secure=true wajib saat HTTPS (production).
# >>> WAJIB true di production (fail-fast) — apps/api/src/main.ts menolak start
#     bila NODE_ENV=production dan COOKIE_SECURE !== "true" (CFG-02).
# DEV: false (HTTP localhost). PROD (HTTPS): true.
COOKIE_SECURE=false

# --- CORS: asal yang diizinkan (koma-pisah); dipakai REST + Socket.IO (/ws) ---
# DEV: akses lewat Nginx :80 (http://localhost) dan langsung web :3000.
# PROD: isi origin nyata pemakai (mis. https://app.sekolah.sch.id).
CORS_ORIGINS=http://localhost:3000,http://localhost,http://localhost:80

# --- Trust proxy: true bila API di belakang reverse proxy (Nginx) ---
# Wajib agar req.ip (rate limit) membaca X-Forwarded-For dengan benar.
# DEV & PROD: true (Nginx :80 selalu mem-proxy ke API).
TRUST_PROXY=true

# --- Rate limit per-IP (in-memory, apps/api/src/common/middleware/rate-limit.middleware.ts) ---
# Jendela waktu (ms), kuota umum per IP, kuota per-IDENTITAS USER (route
# terautentikasi), kuota ketat login (brute-force) & refresh.
# CATATAN: rate limit in-memory bersifat PER-INSTANCE — saat multi-instance
# (scale-out) gunakan store eksternal (mis. Redis) agar kuota konsisten.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
USER_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=30
# Kuota request UPLOAD per user/identitas per jendela (R-22, default 30).
UPLOAD_RATE_LIMIT_MAX=30

# --- Logging (pino) ---
LOG_LEVEL=info

# --- Storage lokal (unggah file; storage.constants.ts) ---
# DEV: relatif dari host (./storage). PROD: /app/storage di container
# (volume opensis-storage di-mount; nilai di-override overlay).
STORAGE_LOCAL_DIR=./storage
# Batas keras GLOBAL ukuran file upload (MB, default 50) — defense-in-depth
# di atas limit per bucket. 0/tidak valid = pakai default.
STORAGE_GLOBAL_MAX_MB=50
# Batas ukuran per BUCKET (MB) — override default per bucket. Nama env:
# STORAGE_MAX_<BUCKET>_MB (bucket "ppdb-documents" → STORAGE_MAX_PPDB_DOCUMENTS_MB).
# Default per bucket (storage.constants.ts): branding/avatars 2, materials 10,
# submissions 20, exports 50, ppdb-documents/ppdb-consents 5, landing 5.
# Contoh override:
# STORAGE_MAX_BRANDING_MB=5
# STORAGE_MAX_MATERIALS_MB=25
# STORAGE_MAX_SUBMISSIONS_MB=50
# STORAGE_MAX_PPDB_DOCUMENTS_MB=10
# Retensi file orphan (hari) sebelum dibersihkan job harian
# (storage-cleanup.processor.ts, default 7; cron 03:17).
STORAGE_ORPHAN_RETENTION_DAYS=7
# Direktori hasil ekspor (grade-export.service.ts). Default: <cwd>/storage/exports.
# STORAGE_EXPORT_DIR=./storage/exports

# --- Geofencing absensi (attendance.service.ts) ---
# Pusat sekolah (latitude/longitude desimal). Tanpa pusat → sinyal GEOFENCING
# TIDAK ditolak (opsional). Di luar GEOFENCE_RADIUS_M dari pusat → 403.
# SCHOOL_LATITUDE=-6.200000
# SCHOOL_LONGITUDE=106.816666
# Radius geofence (meter, default 100; clamp 1..10.000).
GEOFENCE_RADIUS_M=100

# --- Redis + BullMQ (Fase 2+, opsional di dev) ---
# DEV: redis di container, port terekspos ke localhost:6379.
# PROD: host = nama service `redis` (overlay mengganti); tanpa REDIS_URL
#       QueueModule memakai in-process fallback (single-instance).
# Auth redis WAJIB sejak go-live (docker-compose.yml --requirepass):
# password di bawah harus SAMA antara container redis dan REDIS_URL.
# WAJIB diganti: 32+ byte acak di production (mis. `openssl rand -base64 32`).
REDIS_PASSWORD=change-me-32-bytes-random
REDIS_URL=redis://:change-me-32-bytes-random@localhost:6379

# --- Job internal (finance-jobs.service.ts) ---
# Aktifkan scheduler internal (SPP & denda) — default OFF (job tetap bisa
# dipicu manual via controller). Multi-instance: jalankan di SATU instance
# saja agar job tidak dobel.
OPENSIS_ENABLE_JOBS=false
# Interval penjadwalan (ms). Default 21600000 = 6 jam (job harian dilindungi tanggal).
OPENSIS_JOB_INTERVAL_MS=21600000

# --- Cache in-memory (TTL ms) untuk endpoint publik/hot-path (branding,
# landing, feature flags, scope resolver). Default 30000 (30 detik) —
# nilai 0 menonaktifkan cache. Bisa diganti cache terdistribusi (mis. Redis)
# tanpa mengubah kontrak service. ---
# Catatan: modul public-content memakai default TTL 300s bila CACHE_TTL_MS
# tidak di-override (public-content.service.ts:155).
CACHE_TTL_MS=30000

# --- Web (konsumen API; dipakai apps/web) ---
# Base URL API (REST /api/v1).
# DEV: API di host :3001 (NEXT_PUBLIC_* dibaca client saat `npm run dev`).
# PROD: ter-bake saat build image (build arg overlay); akses via Nginx
#       same-origin /api/v1 bila memakai URL relatif.
NEXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
# URL Socket.IO namespace /ws (opsional; default diturunkan dari NEXT_PUBLIC_API_BASE).
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001/ws
# Demo mode web (dipakai apps/web: api-client.ts, proxy.ts; build arg overlay):
# 1 = preview tanpa backend (login demo + data contoh). 0/kosong = normal.
NEXT_PUBLIC_DEMO=0
