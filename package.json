{
  "name": "opensis",
  "version": "0.1.0",
  "private": true,
  "description": "Opensis — SIS super-app untuk SATU sekolah (SMA/SMK Indonesia). Monorepo Turborepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "dev": "turbo run dev",
    "db:generate": "npm run db:generate --workspace=@opensis/database",
    "db:migrate": "npm run db:migrate --workspace=@opensis/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@opensis/database",
    "db:seed": "npm run db:seed --workspace=@opensis/database",
    "db:validate": "npm run db:validate --workspace=@opensis/database",
    "images:landing": "node scripts/generate-landing-images.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.4.2",
    "sharp": "^0.35.3",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "webpack": "^5.105.0",
    "tmp": "^0.2.4",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
}
