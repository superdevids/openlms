// ============================================================
// openlms — Prisma schema (PostgreSQL, single-school)
// Sumber: docs/03-database-erd.md v1.1 (61 entitas) + prd04 §4.3 (RBAC)
//
// Konvensi:
// - id String @id @default(cuid()); created_at/updated_at di semua tabel
//   kecuali Notification & AuditLog (log-like, hanya created_at).
// - Nama tabel snake_case (@@map); field camelCase; kolom FK memakai nama ERD
//   (student_id, created_by, dst.); field relasi diberi nama deskriptif
//   (created_by_user, dst.) agar tidak bertabrakan dengan kolom FK.
// - TANPA kolom school_id — aplikasi untuk SATU sekolah (ADR-001).
// - Enum memakai nilai Bahasa Indonesia sesuai ERD §5.
// - RBAC support (prd04 §4.3): Permission, RolePermission, UserPermissionOverride.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS (docs/03-database-erd.md §5 + prd04 §4.3)
// ============================================================

